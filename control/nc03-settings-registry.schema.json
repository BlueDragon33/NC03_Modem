{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nc03-settings-registry/v1",
  "title": "NC03 Canonical Settings Registry",
  "type": "object",
  "required": [
    "schema",
    "version",
    "projectId",
    "referenceFirmware",
    "sourceParityInventory",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "nc03-settings-registry/v1"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\\\.0\\\\.0$"
    },
    "projectId": {
      "const": "project:nc03-modem"
    },
    "referenceFirmware": {
      "type": "string"
    },
    "sourceParityInventory": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "family",
          "operationClass",
          "ui",
          "valueSchema",
          "safety",
          "capability",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "family": {
            "type": "string"
          },
          "operationClass": {
            "enum": [
              "AUTH",
              "DANGEROUS_ACTION",
              "CREDENTIAL_ACTION",
              "READ",
              "COLLECTION",
              "ACTION_FAMILY",
              "SETTING"
            ]
          },
          "ui": {
            "type": "object",
            "required": [
              "label",
              "controlKind",
              "stockPresence",
              "exposure"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "controlKind": {
                "type": "string",
                "minLength": 1
              },
              "stockPresence": {
                "type": "string",
                "minLength": 1
              },
              "exposure": {
                "enum": [
                  "STOCK_UI",
                  "INTERNAL_STATE"
                ]
              }
            },
            "additionalProperties": false
          },
          "valueSchema": {
            "type": "object",
            "required": [
              "type",
              "validation"
            ],
            "properties": {
              "type": {
                "enum": [
                  "boolean",
                  "integer",
                  "string",
                  "scalar",
                  "enum",
                  "collection",
                  "command"
                ]
              },
              "format": {
                "type": "string"
              },
              "validation": {
                "enum": [
                  "CANONICAL_BOOLEAN",
                  "PROFILE_CONSTRAINED",
                  "STRICT_FORMAT",
                  "TYPED_MODEL_REQUIRED",
                  "COMMAND_POLICY"
                ]
              }
            },
            "additionalProperties": false
          },
          "safety": {
            "type": "object",
            "required": [
              "danger",
              "privacy",
              "readbackPolicy",
              "recoveryPolicy"
            ],
            "properties": {
              "danger": {
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH",
                  "CRITICAL"
                ]
              },
              "privacy": {
                "enum": [
                  "NORMAL",
                  "LOCAL_SENSITIVE",
                  "SECRET"
                ]
              },
              "readbackPolicy": {
                "type": "string"
              },
              "recoveryPolicy": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "capability": {
            "type": "object",
            "required": [
              "lifecycle",
              "readable",
              "writable",
              "hardwareAccepted"
            ],
            "properties": {
              "lifecycle": {
                "enum": [
                  "UNMAPPED",
                  "READ_MAPPED",
                  "WRITE_CANDIDATE",
                  "WRITE_VERIFIED",
                  "HARDWARE_ACCEPTED"
                ]
              },
              "readable": {
                "type": "boolean"
              },
              "writable": {
                "type": "boolean"
              },
              "hardwareAccepted": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "evidence": {
            "type": "object",
            "required": [
              "parityId",
              "stockPresence",
              "readState",
              "writeState",
              "referenceFirmware"
            ],
            "properties": {
              "parityId": {
                "type": "string"
              },
              "stockPresence": {
                "type": "string"
              },
              "readState": {
                "type": "string"
              },
              "writeState": {
                "type": "string"
              },
              "referenceFirmware": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
