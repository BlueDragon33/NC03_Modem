{
  "schema": "application-management.contract/v1",
  "protocol": "nc03-local-first-v1",
  "application": {
    "id": "nc03-modem",
    "name": "NC03 Control Center",
    "shortName": "NC03 Modem",
    "category": "Kỹ thuật",
    "repository": "BlueDragon33/NC03_Modem",
    "version": "0.7.15"
  },
  "capabilities": {
    "webLaunch": true,
    "deviceRegistry": false,
    "deviceApproval": false,
    "deviceBlock": false,
    "deviceUnblock": false,
    "deviceEditPermission": false,
    "deviceIdempotentCommands": false,
    "optimisticConcurrency": false,
    "sessions": false,
    "audit": false,
    "contentReview": false,
    "payments": false,
    "reports": true,
    "liveTelemetry": true,
    "advancedReadSnapshot": true,
    "safeRuleInventoryCounts": true,
    "mobileServiceRead": true,
    "localDiagnosticReport": true,
    "localHarEvidenceAnalyzer": true,
    "inAppHarEvidenceLab": true,
    "sanitizedEvidenceExport": true,
    "harCaptureQualityGuard": true,
    "harModemHostAutoDetection": true,
    "connectionDoctor": true,
    "authSourceProbe": true,
    "authPasswordCodecEvidence": true,
    "authLoginPageDeepProbe": true,
    "loginSubmitCandidateSeparation": true,
    "authProbeDiagnostics": true,
    "loginCallsiteMapping": true,
    "loginPayloadFieldIsolation": true,
    "loginResponseSignalExtraction": true,
    "loginCallArgumentShape": true,
    "loginObjectKeyDiscovery": true,
    "loginTransformTrace": true,
    "loginStructuralTrace": true,
    "authResponseCodeMapping": true,
    "loginPayloadOriginTrace": true,
    "loginPayloadAliasTrace": true,
    "authResultConstantExpansion": true
  },
  "endpoints": {
    "status": "/api/control/status",
    "liveTelemetry": "/api/nc03/snapshot",
    "advancedRead": "/api/nc03/details",
    "connectionDoctor": "/api/nc03/doctor",
    "authSourceProbe": "/api/nc03/auth-source-probe"
  },
  "policy": {
    "remoteAdminReady": false,
    "localFirst": true,
    "modemSecretsInControlPlane": false,
    "modemCommandsFromCloud": false,
    "writeRequiresVerifiedFirmwareMapping": true,
    "liveTelemetryRefreshSeconds": 10,
    "exactBatteryPercentage": true,
    "signalMetric": "qualitative-mnet_sig_level",
    "modemOriginScope": "rfc1918-ipv4-only",
    "pollingPreservesUiState": true,
    "rawRuleInventoryMirrored": false,
    "lastKnownGoodTelemetry": true,
    "staleTelemetryExplicitlyMarked": true,
    "uiBridgeOriginPolicyUnified": true,
    "lastSuccessfulTelemetryTimestamp": true,
    "advancedSnapshotFreshnessExplicit": true,
    "rememberPasswordRequiresVerifiedAuth": true,
    "invalidManualModemAddressRejected": true,
    "diagnosticReportSensitiveFieldsExcluded": true,
    "invalidBatteryPercentageRejected": true,
    "staleAdvancedDataExplicitOnHome": true,
    "reportMissingDataNeverCoercedToZero": true,
    "reportLiveAndAdvancedFreshnessExplicit": true,
    "reportBatteryPercentageValidated": true,
    "authDiscoveryEvidenceOnly": true,
    "writeCandidateNeverAutoVerified": true,
    "harAnalysisLocalOnly": true,
    "harEvidenceExportRedacted": true,
    "authStatusProbeNeverPromotedToLogin": true,
    "authenticatedSessionCaptureRequiresRecapture": true,
    "connectionDoctorReadOnly": true,
    "authSourceProbeLocalOnly": true,
    "authSourceCandidateNeverAutoVerified": true,
    "localRuntimeRejectsStaleDist": true,
    "developerLabProminentInSettings": true,
    "localApiEnvelopeStandardized": true,
    "authDeepProbeReadOnly": true,
    "passiveAuthEndpointsNeverCountAsLoginSubmit": true,
    "authProbeDiagnosticsNoRawSource": true,
    "authProbeParallelFetch": true,
    "getLoginLimitIsPassiveAuthEndpoint": true,
    "loginCallShapeNoLiteralValues": true,
    "loginStructuralTraceNoLiteralValues": true,
    "loginPayloadOriginNoLiteralValues": true
  },
  "boundary": {
    "applicationManagementOwnsModemCredentials": false,
    "applicationManagementProxiesModemTraffic": false,
    "applicationManagementMayInventWriteOperations": false
  }
}
